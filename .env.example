# Database
DATABASE_URL="postgresql://USER:CHANGE_ME@localhost:5432/cineverse_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="CHANGE_ME_USE_A_64_CHAR_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_USE_A_DIFFERENT_64_CHAR_RANDOM_SECRET"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# KKPhim API
KKPHIM_BASE_URL="https://phimapi.com"
KKPHIM_CDN_URL="https://phimimg.com"

# App
PORT=3001
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_NAME="CineVerse"

# TMDB (The Movie Database)
# Lấy tại: https://www.themoviedb.org/settings/api
# Dùng "API Read Access Token" (Bearer token, không phải API Key)
TMDB_ACCESS_TOKEN="your-tmdb-read-access-token-here"
