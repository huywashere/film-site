# Copy to an untracked .env file. Never place real credentials in this template.

# Database / Redis
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cineverse?schema=public"
REDIS_URL="redis://localhost:6379"

# Generate every secret independently with at least 32 random bytes.
JWT_SECRET="replace-with-a-unique-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
TOTP_ENCRYPTION_KEY="replace-with-another-random-secret"
HLS_PROXY_SECRET="replace-with-a-dedicated-random-secret"
HLS_PROXY_ALLOWED_HOSTS="*.phimapi.com,*.phim1280.tv,*.kkphimplayer7.com,*.ophim.live,*.opstream12.com,*.nguonc.com,*.streamc.xyz,*.vsmov.com,*.streamvsmov.com"
ADMIN_METRICS_TOKEN="replace-with-a-dedicated-random-token"
REVALIDATE_SECRET="replace-with-a-dedicated-random-secret"
ADMIN_REQUIRE_2FA="true"
ADMIN_SESSION_BIND_IP="true"
USER_SESSION_BIND_IP="false"
GITHUB_ADMIN_CLIENT_ID=""
GITHUB_ADMIN_CLIENT_SECRET=""
ADMIN_GITHUB_CALLBACK_URL="http://localhost:3002/api/auth/github/callback"
ADMIN_GITHUB_ALLOWED_LOGINS="your-github-login"
ADMIN_GITHUB_ALLOWED_IDS="your-numeric-github-id"
BACKUP_DIR="./backups"
ADMIN_ALERT_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_ID=""
ADMIN_DASHBOARD_USERNAME="admin"
ADMIN_DASHBOARD_PASSWORD="replace-with-a-strong-password"
ADMIN_DASHBOARD_EMAIL="admin@example.com"
CINEVERSE_API_URL="http://localhost:3001/api/v1"

# Movie APIs
KKPHIM_BASE_URL="https://phimapi.com"
KKPHIM_CDN_URL="https://phimimg.com"
TMDB_API_KEY=""
TMDB_ACCESS_TOKEN=""

# App
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NetPhim"

# Authentication integrations
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"
GOOGLE_LINK_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/link/callback"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Observability (leave blank until configured in the deployment secret store)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
