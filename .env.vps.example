# ══════════════════════════════════════════════════════════════
# CineVerse — VPS Environment Variables Template
# Copy file này thành .env trên VPS và điền các giá trị thật
# ══════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=cineverse
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=cineverse_db

# ── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ── JWT Secrets (tạo bằng: openssl rand -base64 64) ───────────
JWT_SECRET=CHANGE_THIS_JWT_SECRET_64_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_64_CHARS_MIN
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── App URLs ───────────────────────────────────────────────────
# Nếu dùng Cloudflare Tunnel: đây là domain từ Cloudflare
# Nếu dùng IP: http://YOUR_VPS_IP
FRONTEND_URL=https://YOUR_DOMAIN_OR_TUNNEL.trycloudflare.com
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN_OR_TUNNEL.trycloudflare.com/api/v1
NEXT_PUBLIC_APP_NAME=CineVerse

# ── Firebase (lấy từ apps/web/.env.local trên máy local) ──────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBgJ17X1FHA2vcu7Uq88Qcnuo3pFCi3Ixk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=film-site-eb0c4.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=film-site-eb0c4
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=film-site-eb0c4.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=872645160784
NEXT_PUBLIC_FIREBASE_APP_ID=1:872645160784:web:402aa0eadfa47ff3884655

# ── Cloudflare Turnstile ───────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAD7XKmxU46dTKv1u
TURNSTILE_SECRET_KEY=0x4AAAAAAAD7XKvRY02t29wqPNZJPU6UaN6c

# ── TMDB (lấy từ apps/web/.env.local trên máy local) ──────────
TMDB_API_KEY=f85dbd29011db19e75f5d29028fd096d
TMDB_ACCESS_TOKEN=YOUR_TMDB_ACCESS_TOKEN_HERE
TMDB_CLOUDFLARE_WORKER_URL=

# ── KKPhim / Ophim API ────────────────────────────────────────
KKPHIM_BASE_URL=https://phimapi.com
KKPHIM_CDN_URL=https://phimimg.com
KKPHIM_API_BASE=https://phimapi.com
OPHIM_API_BASE=https://ophim1.com
