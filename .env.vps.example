# ══════════════════════════════════════════════════════════════
# CineVerse — VPS Environment Variables Template
# Copy file này thành .env trên VPS và điền các giá trị thật
# ══════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=cineverse
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=cineverse_db

# ── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ── JWT Secrets (tạo bằng: openssl rand -base64 64) ───────────
JWT_SECRET=CHANGE_THIS_JWT_SECRET_64_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_64_CHARS_MIN
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── TOTP Encryption Key (tạo bằng: openssl rand -base64 32) ───
# PHẢI KHÁC với JWT_SECRET — dùng riêng để mã hóa TOTP 2FA secret
TOTP_ENCRYPTION_KEY=CHANGE_THIS_TOTP_KEY_32_CHARS_MIN

# ── App URLs ───────────────────────────────────────────────────
# Nếu dùng Cloudflare Tunnel: đây là domain từ Cloudflare
# Nếu dùng IP: http://YOUR_VPS_IP
FRONTEND_URL=https://YOUR_DOMAIN_OR_TUNNEL.trycloudflare.com
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN_OR_TUNNEL.trycloudflare.com/api/v1
NEXT_PUBLIC_APP_NAME=CineVerse

# ── Firebase (lấy từ Firebase Console → Project Settings → Your apps) ────
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# ── Cloudflare Turnstile ───────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# ── TMDB (lấy từ apps/web/.env.local trên máy local) ──────────
TMDB_API_KEY=f85dbd29011db19e75f5d29028fd096d
TMDB_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiJmODVkYmQyOTAxMWRiMTllNzVmNWQyOTAyOGZkMDk2ZCIsIm5iZiI6MTc4NTE2NDEyOS4wODMwMDAyLCJzdWIiOiI2YTY3NzE2MWNkNjJlYWY2OTA3NTZjYjYiLCJzY29wZXMiOlsiYXBpX3JlYWQiXSwidmVyc2lvbiI6MX0.n4OmY5WRWjghthj8WxxFAWivdtvgK7KdOYO44WT3qTk
TMDB_CLOUDFLARE_WORKER_URL=

# ── Movie API Sources ────────────────────────────────────────────
# KKPhim
KKPHIM_BASE_URL=https://phimapi.com
KKPHIM_CDN_URL=https://phimimg.com
KKPHIM_API_BASE=https://phimapi.com
# OPhim (primary: ophim1.com — domain dự phòng được xử lý tự động)
OPHIM_API_BASE=https://ophim1.com
# VSMov — QUAN TRỌNG: KHÔNG có /api ở cuối
VSMOV_API_BASE=https://vsmov.com
# NguonC — endpoint /api là prefix trong base URL
NGUONC_API_BASE=https://phim.nguonc.com/api
