# CineVerse VPS template. Copy to an untracked .env on the VPS.
# Rotate any credential that has ever appeared in Git history.

POSTGRES_USER=cineverse
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=cineverse
REDIS_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-a-unique-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TOTP_ENCRYPTION_KEY=replace-with-another-random-secret
HLS_PROXY_SECRET=replace-with-a-dedicated-random-secret
HLS_PROXY_ALLOWED_HOSTS=*.phimapi.com,*.phim1280.tv,*.kkphimplayer7.com,*.ophim.live,*.opstream12.com,*.nguonc.com,*.streamc.xyz,*.vsmov.com,*.streamvsmov.com
ADMIN_METRICS_TOKEN=replace-with-a-dedicated-random-token
REVALIDATE_SECRET=replace-with-a-dedicated-random-secret
ADMIN_REQUIRE_2FA=true
GITHUB_ADMIN_CLIENT_ID=
GITHUB_ADMIN_CLIENT_SECRET=
ADMIN_GITHUB_CALLBACK_URL=https://admin.example.com/api/auth/github/callback
ADMIN_GITHUB_ALLOWED_LOGINS=your-github-login
ADMIN_ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

FRONTEND_URL=https://example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_APP_NAME=NetPhim
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_CLOUDFLARE_WORKER_URL=

KKPHIM_BASE_URL=https://phimapi.com
KKPHIM_CDN_URL=https://phimimg.com
KKPHIM_API_BASE=https://phimapi.com
OPHIM_API_BASE=https://ophim1.com
KKPHIM_API_ORIGINS=https://phimapi.com
OPHIM_API_ORIGINS=https://ophim1.com,https://ophim17.cc,https://ophim3.cc
VSMOV_API_BASE=https://vsmov.com/api
VSMOV_API_ORIGINS=https://vsmov.com/api
NGUONC_API_BASE=https://phim.nguonc.com/api
NGUONC_API_ORIGINS=https://phim.nguonc.com/api

ADMIN_DASHBOARD_USERNAME=admin
ADMIN_DASHBOARD_PASSWORD=replace-with-a-long-random-password
