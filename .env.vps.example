# CineVerse VPS template. Copy to an untracked .env on the VPS.
# Rotate any credential that has ever appeared in Git history.

POSTGRES_USER=cineverse
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=cineverse
REDIS_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-a-unique-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TOTP_ENCRYPTION_KEY=replace-with-another-random-secret
HLS_PROXY_SECRET=replace-with-a-dedicated-random-secret
HLS_PROXY_ALLOWED_HOSTS=*.phimapi.com,*.ophim.live,*.nguonc.com,*.vsmov.com
ADMIN_METRICS_TOKEN=replace-with-a-dedicated-random-token

FRONTEND_URL=https://example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_APP_NAME=CineVerse
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_CLOUDFLARE_WORKER_URL=

KKPHIM_BASE_URL=https://phimapi.com
KKPHIM_CDN_URL=https://phimimg.com
KKPHIM_API_BASE=https://phimapi.com
OPHIM_API_BASE=https://ophim1.com
VSMOV_API_BASE=https://vsmov.com
NGUONC_API_BASE=https://phim.nguonc.com/api

ADMIN_DASHBOARD_USERNAME=admin
ADMIN_DASHBOARD_PASSWORD=replace-with-a-long-random-password
