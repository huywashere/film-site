# URL của ứng dụng web CineVerse mà dashboard sẽ kiểm tra qua các proxy API.
CINEVERSE_WEB_URL=http://127.0.0.1:3000
# NestJS API and server-only token for operational performance metrics.
CINEVERSE_API_URL=http://127.0.0.1:3001/api/v1
ADMIN_METRICS_TOKEN=replace-with-the-same-long-random-token
# Required in production. Use a generated password with at least 32 random
# characters and keep the real value in the deployment secret store.
ADMIN_DASHBOARD_USERNAME=admin
ADMIN_DASHBOARD_PASSWORD=replace-with-a-long-random-password
