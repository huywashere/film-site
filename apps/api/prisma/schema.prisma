// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// FIX #14: Dùng enum thay vì String cho role — type-safe, tránh typo
enum Role {
  USER
  ADMIN
  MODERATOR
  CONTENT_EDITOR
  OPERATIONS
  ANALYST

  @@map("role")
}

enum BackupStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  RESTORED

  @@map("backup_status")
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED

  @@map("incident_status")
}

enum IssueStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED

  @@map("issue_status")
}

enum IssuePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL

  @@map("issue_priority")
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED

  @@map("sync_job_status")
}

enum MediaUploadStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED

  @@map("media_upload_status")
}

enum AdType {
  BANNER_TOP
  BANNER_BOTTOM
  BANNER_PLAYER
  VIDEO_PREROLL
  POPUNDER
  CUSTOM_HTML

  @@map("ad_type")
}

model User {
  id                       String         @id @default(cuid())
  email                    String         @unique
  username                 String         @unique
  passwordHash             String
  displayName              String?
  avatarUrl                String?
  nameColor                String?
  avatarFrameColor         String?
  bio                      String?
  role                     Role           @default(USER) // FIX #14: enum thay vì String
  isBanned                 Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  isEmailVerified          Boolean        @default(false)
  googleId                 String?        @unique
  githubId                 String?        @unique
  twoFactorEnabled         Boolean        @default(false)
  twoFactorAuth            TwoFactorAuth?
  isLocked                 Boolean        @default(false)
  suspiciousToken          String?
  suspiciousTokenExpiresAt DateTime?
  adminAccessEnabled       Boolean        @default(false)
  adminPermissions         String[]       @default([])

  watchlist           Watchlist[]
  reviews             Review[]
  ratings             Rating[]
  following           Follow[]              @relation("follower")
  followers           Follow[]              @relation("following")
  reviewLikes         ReviewLike[]
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  resetTokens         ResetPasswordToken[]
  watchHistories      WatchHistory[]
  adminSessions       AdminSession[]
  notifications       UserNotification[]
  movieSubscriptions  MovieSubscription[]
  preferences         UserPreference?
  playlists           Playlist[]

  @@map("users")
}

model AdminSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?   @db.Text
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("admin_sessions")
}

model TwoFactorAuth {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String
  backupCodes String[]
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auths")
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  userAgent  String?  @db.Text
  ipAddress  String?
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model ResetPasswordToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reset_password_tokens")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Movie {
  id              String   @id // kkphim slug
  title           String
  titleEn         String?
  originName      String?
  posterUrl       String?
  thumbUrl        String?
  year            Int?
  type            String // "series" | "single" | "hoathinh" | "tvshows"
  status          String? // "completed" | "ongoing"
  totalEpisodes   Int?
  description     String?  @db.Text
  quality         String?
  language        String?
  runtime         Int? // phút
  imdbId          String?
  trailerUrl      String?
  genres          String[] @default([])
  countries       String[] @default([])
  actors          String[] @default([])
  directors       String[] @default([])
  releaseSchedule Json?
  isHidden        Boolean  @default(false)
  sources         String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  watchlist          Watchlist[]
  reviews            Review[]
  ratings            Rating[]
  viewLogs           ViewLog[]
  watchHistories     WatchHistory[]
  playbackSources    MoviePlaybackSource[]
  playbackEvents     PlaybackEvent[]
  subscriptions      MovieSubscription[]
  playlistItems      PlaylistItem[]
  mediaUploadJobs    MediaUploadJob[]

  @@index([type, isHidden, year])
  @@index([isHidden, updatedAt(sort: Desc)])
  @@index([genres], type: Gin, map: "movies_genres_gin_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "movies_title_trgm_idx")
  @@index([titleEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "movies_titleEn_trgm_idx")
  @@index([originName(ops: raw("gin_trgm_ops"))], type: Gin, map: "movies_originName_trgm_idx")
  @@map("movies")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String // e.g. "LOCK_USER", "UNLOCK_USER", "HIDE_MOVIE", "UNHIDE_MOVIE", "EDIT_METADATA", "FORCE_CLOSE_PARTY"
  targetId   String?
  details    String?  @db.Text
  // FIX #11: Thêm IP và User-Agent để truy vết forensics
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model IssueReport {
  id                String             @id @default(cuid())
  category          String
  filmTitle         String?
  movieSlug         String?
  episode           String?
  serverName        String?
  deviceInfo        String?            @db.Text
  description       String             @db.Text
  email             String?
  status            IssueStatus        @default(NEW)
  priority          IssuePriority      @default(NORMAL)
  adminNote         String?            @db.Text
  screenshotUrl     String?
  assignedTo        String?
  resolvedBy        String?
  resolutionMessage String?            @db.Text
  resolvedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  events            IssueReportEvent[]

  @@index([status, priority, createdAt(sort: Desc)])
  @@index([movieSlug])
  @@map("issue_reports")
}

model SyncJob {
  id             String        @id @default(cuid())
  source         String
  status         SyncJobStatus @default(QUEUED)
  processedCount Int           @default(0)
  createdCount   Int           @default(0)
  updatedCount   Int           @default(0)
  failedCount    Int           @default(0)
  requestedPages Int           @default(5)
  currentPage    Int           @default(0)
  retryCount     Int           @default(0)
  heartbeatAt    DateTime?
  errorMessage   String?       @db.Text
  requestedBy    String
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastForSchedules SyncSchedule[] @relation("LastSyncJob")

  @@index([createdAt(sort: Desc)])
  @@index([source, status])
  @@map("sync_jobs")
}

model SyncSchedule {
  id        String    @id @default(cuid())
  name      String
  source    String
  cron      String
  pages     Int       @default(5)
  enabled   Boolean   @default(true)
  nextRunAt DateTime
  lastRunAt DateTime?
  lastJobId String?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastJob   SyncJob?  @relation("LastSyncJob", fields: [lastJobId], references: [id], onDelete: SetNull)

  @@index([enabled, nextRunAt])
  @@index([lastJobId])
  @@map("sync_schedules")
}

model DatabaseBackup {
  id            String       @id @default(cuid())
  status        BackupStatus @default(QUEUED)
  filename      String?
  fileSizeBytes BigInt?
  checksum      String?
  requestedBy   String
  restoredBy    String?
  errorMessage  String?      @db.Text
  startedAt     DateTime?
  finishedAt    DateTime?
  restoredAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("database_backups")
}

model SystemIncident {
  id              String         @id @default(cuid())
  fingerprint     String
  source          String
  title           String
  message         String         @db.Text
  severity        String         @default("warning")
  status          IncidentStatus @default(OPEN)
  occurrenceCount Int            @default(1)
  metadata        Json?
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  resolvedBy      String?
  resolvedAt      DateTime?
  lastSeenAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, severity, lastSeenAt(sort: Desc)])
  @@index([fingerprint, status])
  @@map("system_incidents")
}

model SiteConfiguration {
  id                    String   @id @default("primary")
  maintenanceMode       Boolean  @default(false)
  maintenanceNotice     String?  @db.Text
  announcementText      String?  @db.Text
  announcementLink      String?
  homePopupEnabled      Boolean  @default(false)
  homePopupTitle        String?
  homePopupBody         String?  @db.Text
  homePopupLink         String?
  homePopupLinkLabel    String?
  homePopupDismissLabel String?
  homePopupVersion      Int      @default(1)
  heroMovieSlugs        String[] @default([])
  providerPriority      String[] @default(["kkphim", "ophim", "nguonc", "vsmov"])
  autoSkipIntro         Boolean  @default(false)
  watchPartyEnabled     Boolean  @default(true)
  homeTop10Slugs        String[] @default([])
  homeSectionOrder      String[] @default(["top10", "continue", "schedule", "latest", "vfx", "usuk-series", "action", "scifi", "horror", "historical", "theatrical"])
  homeHiddenSections    String[] @default([])
  homeFeaturedRows      Json?
  seoTitle              String?  @default("FlexPhim - Xem phim trực tuyến")
  seoDescription        String?  @db.Text
  cacheVersion          Int      @default(1)
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("site_configuration")
}

model SiteConfigurationRevision {
  id        String   @id @default(cuid())
  snapshot  Json
  changedBy String
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("site_configuration_revisions")
}

model MoviePlaybackSource {
  id            String    @id @default(cuid())
  movieId       String
  provider      String
  providerSlug  String
  episodeKey    String    @default("full")
  episodeName   String?
  serverName    String
  streamUrl     String?   @db.Text
  subtitleUrls  Json?
  introStart    Int?
  introEnd      Int?
  outroStart    Int?
  adCuePoints   Int[]     @default([])
  priority      Int       @default(0)
  healthStatus  String    @default("unknown")
  lastCheckedAt DateTime?
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([movieId, provider, providerSlug, episodeKey, serverName])
  @@index([movieId, episodeKey, priority])
  @@index([provider, healthStatus])
  @@map("movie_playback_sources")
}

model MediaUploadJob {
  id              String            @id @default(cuid())
  movieId         String
  episodeKey      String            @default("full")
  episodeName     String?
  serverName      String            @default("FlexPhim")
  status          MediaUploadStatus @default(QUEUED)
  sourcePath      String            @db.Text
  outputKey       String?
  manifestUrl     String?           @db.Text
  durationSeconds Int?
  sourceWidth     Int?
  sourceHeight    Int?
  progress        Int               @default(0)
  errorMessage    String?           @db.Text
  requestedBy     String
  createdAt       DateTime          @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  updatedAt       DateTime          @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([movieId, createdAt(sort: Desc)])
  @@map("media_upload_jobs")
}

model PlaybackEvent {
  id         String   @id @default(cuid())
  eventType  String
  movieId    String?
  sessionId  String?
  userId     String?
  route      String?
  provider   String?
  serverName String?
  episode    String?
  quality    String?
  deviceType String?
  country    String?
  errorCode  String?
  bufferMs   Int?
  durationMs Int?
  fromSource String?
  toSource   String?
  metadata   Json?
  occurredAt DateTime @default(now())

  movie Movie? @relation(fields: [movieId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc), eventType])
  @@index([eventType, occurredAt(sort: Desc)])
  @@index([movieId, occurredAt(sort: Desc)])
  @@index([provider, serverName, occurredAt(sort: Desc)])
  @@map("playback_events")
}

model SearchEvent {
  id          String   @id @default(cuid())
  query       String
  normalized  String
  resultCount Int      @default(0)
  route       String?
  sessionId   String?
  userId      String?
  deviceType  String?
  occurredAt  DateTime @default(now())

  @@index([occurredAt(sort: Desc)])
  @@index([normalized, occurredAt(sort: Desc)])
  @@map("search_events")
}

model AdminNotification {
  id        String                  @id @default(cuid())
  type      String
  title     String
  message   String                  @db.Text
  severity  String                  @default("info")
  link      String?
  createdAt DateTime                @default(now())
  expiresAt DateTime?
  reads     AdminNotificationRead[]

  @@index([createdAt(sort: Desc)])
  @@map("admin_notifications")
}

model AdminNotificationRead {
  notificationId String
  adminKey       String
  readAt         DateTime @default(now())

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, adminKey])
  @@index([adminKey, readAt(sort: Desc)])
  @@map("admin_notification_reads")
}

model SystemNotification {
  id          String    @id @default(cuid())
  title       String
  message     String    @db.Text
  tag         String?   @default("Hệ thống")
  link        String?
  isActive    Boolean   @default(true)
  priority    Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, priority(sort: Desc), createdAt(sort: Desc)])
  @@map("system_notifications")
}

model IssueReportEvent {
  id         String       @id @default(cuid())
  reportId   String
  actorId    String
  actorEmail String
  action     String
  fromStatus IssueStatus?
  toStatus   IssueStatus?
  note       String?      @db.Text
  createdAt  DateTime     @default(now())

  report IssueReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt(sort: Desc)])
  @@map("issue_report_events")
}

model WatchPartyArchive {
  id               String   @id
  name             String
  movieSlug        String?
  movieName        String?
  episode          String?
  hostName         String?
  peakParticipants Int      @default(0)
  messageCount     Int      @default(0)
  closeReason      String?
  createdAt        DateTime
  endedAt          DateTime @default(now())

  @@index([endedAt(sort: Desc)])
  @@index([movieSlug])
  @@map("watch_party_archives")
}

model Watchlist {
  id      String   @id @default(cuid())
  userId  String
  movieId String
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId, addedAt(sort: Desc), id(sort: Desc)])
  @@map("watchlists")
}

model Review {
  id             String    @id @default(cuid())
  userId         String
  movieId        String
  content        String    @db.Text
  rating         Float? // 0.5 - 5.0 (half star)
  likeCount      Int       @default(0)
  isHidden       Boolean   @default(false)
  moderationNote String?   @db.Text
  moderatedBy    String?
  moderatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  likes ReviewLike[]

  @@index([movieId, createdAt(sort: Desc)])
  @@index([isHidden, createdAt(sort: Desc)])
  @@index([userId])
  @@map("reviews")
}

model ReviewLike {
  userId   String
  reviewId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@index([reviewId])
  @@map("review_likes")
}

model Rating {
  userId  String
  movieId String
  score   Float // 0.5 - 5.0

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([movieId])
  @@map("ratings")
}

model ViewLog {
  id         String   @id @default(cuid())
  movieId    String
  episode    String?
  serverName String?
  viewedAt   DateTime @default(now())

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([viewedAt(sort: Desc), movieId])
  @@index([movieId, viewedAt(sort: Desc)])
  @@map("view_logs")
}

model WatchHistory {
  id         String   @id @default(cuid())
  userId     String
  movieId    String
  movieTitle String
  movieThumb String?
  episode    String? // e.g. "1", "2", "tap-1"
  progress   Float    @default(0) // seconds watched
  duration   Float    @default(0) // total video duration in seconds
  serverName String?
  watchedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  // One record per (user, movie, episode) — upserted on every sync
  @@unique([userId, movieId, episode])
  @@index([userId, watchedAt(sort: Desc), id(sort: Desc)])
  @@index([userId, movieId, watchedAt(sort: Desc)])
  @@map("watch_histories")
}

model IpBlockRule {
  id        String    @id @default(cuid())
  ipAddress String    @unique
  reason    String?   @db.Text
  blockedBy String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([expiresAt, createdAt(sort: Desc)])
  @@map("ip_block_rules")
}

model AdPlacement {
  id            String    @id @default(cuid())
  title         String
  type          AdType
  imageUrl      String?
  targetUrl     String?
  htmlContent   String?   @db.Text
  videoVastUrl  String?
  videoDuration Int?      @default(15) // seconds
  skipOffsetSec Int?      @default(5) // skip after seconds
  categories    String[]  @default([]) // empty = all categories
  isActive      Boolean   @default(true)
  startDate     DateTime?
  endDate       DateTime?
  impressions   Int       @default(0)
  clicks        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([type, isActive])
  @@map("ad_placements")
}

// ── USER NOTIFICATIONS ────────────────────────────────────────────

enum NotificationType {
  NEW_EPISODE        // Phim series có tập mới
  REVIEW_LIKED       // Review của bạn được like
  NEW_FOLLOWER       // Có người follow bạn
  SYSTEM_ANNOUNCE    // Thông báo hệ thống (maintenance, update...)
  REVIEW_REPLY       // Có người reply review của bạn
  MOVIE_AVAILABLE    // Phim bạn đang chờ đã có

  @@map("notification_type")
}

model UserNotification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String           @db.Text
  link       String?          // Deep link tới trang liên quan (/film/slug, /review/id)
  imageUrl   String?          // Ảnh thumbnail (poster phim, avatar người follow)
  isRead     Boolean          @default(false)
  readAt     DateTime?
  expiresAt  DateTime?        // Tự xóa sau thời gian (optional)
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt, expiresAt]) // dùng cho cleanup job
  @@map("user_notifications")
}

// ── MOVIE SUBSCRIPTIONS (Theo dõi cập nhật phim) ──────────────────

model MovieSubscription {
  userId      String
  movieId     String
  notifyEmail Boolean  @default(false) // gửi email khi có tập mới
  notifyPush  Boolean  @default(true)  // gửi push/in-app notification
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([movieId]) // dùng khi fan-out thông báo cho tất cả subscriber của 1 phim
  @@map("movie_subscriptions")
}

// ── USER PREFERENCES (Cài đặt cá nhân) ───────────────────────────

model UserPreference {
  userId                String  @id
  // Playback
  defaultQuality        String  @default("auto")    // "auto" | "1080p" | "720p" | "480p"
  defaultSubtitle       String  @default("vi")      // "vi" | "en" | "off"
  autoplay              Boolean @default(true)
  autoSkipIntro         Boolean @default(false)
  autoSkipOutro         Boolean @default(false)
  preferredServer       String? // tên server ưu tiên
  preferredProvider     String? // "kkphim" | "nguonc" | "vsmov"
  // UI / Display
  theme                 String  @default("dark")    // "dark" | "light" | "system"
  language              String  @default("vi")      // giao diện
  contentLanguage       String  @default("all")     // lọc phim theo ngôn ngữ
  // Notifications
  emailNotifications    Boolean @default(true)
  pushNotifications     Boolean @default(true)
  notifyNewEpisode      Boolean @default(true)
  notifyReviewLiked     Boolean @default(true)
  notifyNewFollower     Boolean @default(true)
  // Parental Control
  contentFilter         String  @default("all")     // "all" | "safe" | "teen"
  // Timestamps
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ── PLAYLISTS (Danh sách phim tự tạo) ────────────────────────────

model Playlist {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?        @db.Text
  coverUrl    String?        // ảnh bìa playlist (auto = poster phim đầu tiên)
  isPublic    Boolean        @default(false) // public = người khác xem được
  itemCount   Int            @default(0)     // denormalized counter
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([isPublic, updatedAt(sort: Desc)]) // dùng cho trang khám phá playlist public
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  movieId    String
  note       String?  @db.Text // ghi chú cá nhân cho phim này trong playlist
  position   Int      @default(0) // thứ tự trong playlist (để sort)
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  movie    Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([playlistId, movieId]) // 1 phim chỉ xuất hiện 1 lần trong playlist
  @@index([playlistId, position])
  @@index([movieId])
  @@map("playlist_items")
}
