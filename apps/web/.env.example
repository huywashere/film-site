# Upstream Movie API base URLs (Server-side environment variables only)
KKPHIM_API_BASE=https://phimapi.com
OPHIM_API_BASE=https://ophim1.com
NGUONC_API_BASE=https://phim.nguonc.com/api
VSMOV_API_BASE=https://vsmov.com/api
VICDN_API_BASE=https://vicdn.cc/api

# Optional comma-separated failover pools. Update these at deploy time when a
# provider changes domain; the legacy single-origin values above remain valid.
KKPHIM_API_ORIGINS=https://phimapi.com
OPHIM_API_ORIGINS=https://ophim1.com,https://ophim17.cc,https://ophim3.cc
NGUONC_API_ORIGINS=https://phim.nguonc.com/api
VSMOV_API_ORIGINS=https://vsmov.com/api
VICDN_API_ORIGINS=https://vicdn.cc/api,https://api.vicdn.cc/api
MEDIA_GATEWAY_INTERNAL_URL=http://127.0.0.1:8081

# Client-side API URL for footer banner
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379

# Firebase Authentication Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google One Tap Sign-In (OAuth 2.0 Web Client ID from Firebase / Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Sentry Error Tracking DSN (Cấu hình DSN theo dõi lỗi từ sentry.io)
NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare Turnstile Bot Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only metadata credentials. Never prefix these with NEXT_PUBLIC_.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
OMDB_API_KEY=

# Optional: public, commit/tag-pinned jsDelivr directory containing images/, avatars/ and config/.
# Leave blank to serve all decorative assets from apps/web/public.
NEXT_PUBLIC_DECORATIVE_ASSET_CDN_BASE_URL=
