# Production Environment Variables
NEXT_PUBLIC_API_URL=https://demo-api.vercel.app/api/v1
NEXT_PUBLIC_APP_NAME=CineVerse
NODE_ENV=production

# Feature Flags (disable features that need backend)
NEXT_PUBLIC_ENABLE_AUTH=false
NEXT_PUBLIC_ENABLE_WATCHLIST=false
NEXT_PUBLIC_ENABLE_COMMENTS=false

# KKPhim API (works without backend)
KKPHIM_BASE_URL=https://phimapi.com
