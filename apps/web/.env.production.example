# Public build-time values only. Keep server credentials in the deployment
# secret store and inject them at runtime.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_APP_NAME=NetPhim
NODE_ENV=production

NEXT_PUBLIC_ENABLE_AUTH=true
NEXT_PUBLIC_ENABLE_WATCHLIST=true
NEXT_PUBLIC_ENABLE_COMMENTS=true
KKPHIM_API_BASE=https://phimapi.com
OPHIM_API_BASE=https://ophim1.com
NGUONC_API_BASE=https://phim.nguonc.com/api
VSMOV_API_BASE=https://vsmov.com/api
KKPHIM_API_ORIGINS=https://phimapi.com
OPHIM_API_ORIGINS=https://ophim1.com,https://ophim17.cc,https://ophim3.cc
NGUONC_API_ORIGINS=https://phim.nguonc.com/api
VSMOV_API_ORIGINS=https://vsmov.com/api
HLS_PROXY_SECRET=replace-with-a-runtime-only-random-secret
HLS_PROXY_ALLOWED_HOSTS=*.phimapi.com,*.phim1280.tv,*.kkphimplayer7.com,*.ophim.live,*.opstream12.com,*.nguonc.com,*.streamc.xyz,*.vsmov.com,*.streamvsmov.com
