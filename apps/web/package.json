{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/check-performance-budget.mjs",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=9999",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "perf:waterfall:4g": "node scripts/audit-waterfall.mjs",
    "lint:fix": "eslint src --ext .ts,.tsx --fix --max-warnings=9999",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "tsx --test src/lib/player-source-routing.test.mts src/lib/hero-image.test.mts src/lib/hls-proxy-signature.test.mts src/lib/hls-ad-filter.test.mts src/lib/image-cdn.test.mts src/lib/movie-api-resilience.test.mts src/lib/movie-image-url.test.mts src/lib/notification-read-state.test.mts src/lib/tmdb-image-url.test.mts src/lib/chunk-load-recovery.test.mts src/lib/catalog-curation.test.mts src/lib/decorative-asset-cdn.test.mts src/lib/search-intelligence.test.mts",
    "test:source-routing": "tsx --test src/lib/player-source-routing.test.mts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@netphim/shared-types": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.0.0",
    "artplayer": "^5.4.0",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "core-js": "^3.49.0",
    "firebase": "^12.16.0",
    "framer-motion": "^11.0.0",
    "gsap": "^3.15.0",
    "hls.js": "^1.6.16",
    "ioredis": "^5.11.1",
    "lenis": "^1.3.25",
    "lucide-react": "^0.400.0",
    "next": "16.2.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "regenerator-runtime": "^0.14.1",
    "socket.io-client": "^4",
    "swiper": "^14.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.11",
    "typescript": "^5.0.0"
  }
}
