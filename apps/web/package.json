{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build && node scripts/check-performance-budget.mjs",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=22",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "perf:waterfall:4g": "node scripts/audit-waterfall.mjs",
    "lint:fix": "eslint src --ext .ts,.tsx --fix --max-warnings=9999",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test e2e/critical-flows.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "tsx --test src/lib/player-source-routing.test.mts src/lib/watch-player-ui.test.mts src/lib/vicdn-normalizer.test.mts src/lib/hero-image.test.mts src/lib/hls-proxy-signature.test.mts src/lib/hls-ad-filter.test.mts src/lib/image-cdn.test.mts src/lib/universe-artwork.test.mts src/lib/movie-api-resilience.test.mts src/lib/movie-image-url.test.mts src/lib/notification-read-state.test.mts src/lib/tmdb-image-url.test.mts src/lib/chunk-load-recovery.test.mts src/lib/catalog-curation.test.mts src/lib/decorative-asset-cdn.test.mts src/lib/search-intelligence.test.mts src/lib/security-hardening.test.mts src/lib/entry-splash.test.mts src/lib/resolve-image-url.test.mts src/lib/string-utils.test.mts src/lib/actor-film-matcher.test.mts src/lib/movie-parts.test.mts src/lib/episode-air-schedule.test.mts src/lib/user-data.test.mts src/lib/trailer-filter.test.mts src/lib/scrubber-sprite.test.mts",
    "test:source-routing": "tsx --test src/lib/player-source-routing.test.mts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@netphim/shared-types": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.103.2",
    "artplayer": "^5.4.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "core-js": "^3.50.0",
    "dompurify": "^3.4.16",
    "firebase": "^12.19.0",
    "framer-motion": "^11.0.0",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.3",
    "ioredis": "^5.11.1",
    "lenis": "^1.3.26",
    "lucide": "^1.48.0",
    "lucide-react": "^0.577.0",
    "morphicons": "^1.7.1",
    "next": "16.3.6",
    "page-mascot": "^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "regenerator-runtime": "^0.14.1",
    "socket.io-client": "^4",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  }
}
