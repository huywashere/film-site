# FlexPhim API image for Railway.
# The Railway service must keep its Root Directory at the repository root so
# pnpm can use the monorepo lockfile deterministically.

ARG NODE_VERSION=20
ARG PNPM_VERSION=9.5.0

FROM node:${NODE_VERSION}-alpine AS base
ARG PNPM_VERSION
RUN apk add --no-cache openssl && \
    corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

FROM base AS builder

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc turbo.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/shared-types/package.json ./packages/shared-types/package.json
COPY apps/api ./apps/api
COPY packages/shared-types ./packages/shared-types

# Install from the committed workspace lockfile. Dev dependencies are required
# only in this stage for Nest and TypeScript compilation.
RUN pnpm install --frozen-lockfile --filter api...

RUN pnpm --dir apps/api exec prisma generate --schema=prisma/schema.prisma && \
    pnpm --dir apps/api build

# Produce a portable production package so the runtime image contains neither
# the monorepo nor build-only tooling.
RUN pnpm --filter api deploy --prod /prod/api && \
    cp -R apps/api/dist /prod/api/dist && \
    cp -R apps/api/prisma /prod/api/prisma && \
    cd /prod/api && ./node_modules/.bin/prisma generate --schema=prisma/schema.prisma

FROM node:${NODE_VERSION}-alpine AS runtime
RUN apk add --no-cache openssl ffmpeg

ENV NODE_ENV=production
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs && \
    mkdir -p /app/media /app/uploads /app/transcode && \
    chown -R nestjs:nodejs /app/media /app/uploads /app/transcode

COPY --from=builder --chown=nestjs:nodejs /prod/api ./

USER nestjs
EXPOSE 3001

CMD ["node", "dist/src/main.js"]
