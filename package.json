{
  "name": "netphim",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:all": "start-all.bat",
    "stop:all": "stop-all.bat",
    "dev:admin": "pnpm --filter @netphim/admin-cms dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "db:studio": "cd apps/api && npx prisma studio",
    "db:seed": "cd apps/api && npx prisma db seed",
    "db:explain": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-db-explain.ps1",
    "db:performance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/report-db-performance.ps1",
    "perf:waterfall:4g": "pnpm --filter web perf:waterfall:4g",
    "preview:sprites": "node scripts/generate-scrubber-sprites.mjs",
    "docker:build": "docker compose --project-directory . -f infra/docker/docker-compose.yml build",
    "docker:up": "docker compose --project-directory . -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose --project-directory . -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose --project-directory . -f infra/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "ajv": "^8.18.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "imagetracerjs": "^1.2.6",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=18"
  },
