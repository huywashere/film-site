# ── CineVerse Terraform Credentials Example ─────────────────────────
# Rename this file to 'terraform.tfvars' and fill in your tokens.

do_token             = "dop_v1_your_digitalocean_token_here"
cloudflare_api_token = "your_cloudflare_api_token_here"
cloudflare_zone_id   = "your_cloudflare_zone_id_here"
domain_name          = "netphim.example"
vps_region           = "sgp1"
vps_size             = "s-2vcpu-4gb"
ssh_public_key       = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ..."
admin_ssh_cidrs      = ["203.0.113.10/32"]

# Keep "full" for the generated bootstrap certificate. After installing a
# Cloudflare Origin CA certificate in ./ssl, change this to "strict".
cloudflare_ssl_mode  = "full"
